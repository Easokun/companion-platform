/* pages/orderDetail/orderDetail.wxss */
.page-container {
  min-height: 100vh;
  background: #F5F5F7;
}

.status-bar {
  width: 100%;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: #FFFFFF;
}

.nav-back {
  font-size: 48rpx;
  color: #333333;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333333;
}

/* 状态卡片 */
.status-card {
  display: flex;
  align-items: center;
  margin: 30rpx;
  padding: 40rpx 32rpx;
  border-radius: 24rpx;
}

.status-card-0 { background: linear-gradient(135deg, #FF9800, #FFB74D); }
.status-card-1 { background: linear-gradient(135deg, #2196F3, #64B5F6); }
.status-card-2 { background: linear-gradient(135deg, #4CAF50, #66BB6A); }
.status-card-3 { background: linear-gradient(135deg, #FF6B6B, #FF8E8E); }
.status-card-4 { background: linear-gradient(135deg, #9E9E9E, #BDBDBD); }
.status-card-5 { background: linear-gradient(135deg, #06B6D4, #22D3EE); }
.status-card-6 { background: linear-gradient(135deg, #EC4899, #F472B6); }
.status-card-7 { background: linear-gradient(135deg, #8B5CF6, #A78BFA); }

.status-icon {
  font-size: 56rpx;
  margin-right: 24rpx;
}

.status-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #FFFFFF;
}

.status-desc {
  font-size: 24rpx;
  color: #FFFFFF;
  margin-top: 12rpx;
  opacity: 0.8;
}

/* 护航退单提示 */
.cancel-notice {
  margin: 0 30rpx 24rpx;
  padding: 24rpx 28rpx;
  background: #FFF7ED;
  border: 1px solid #FED7AA;
  border-radius: 16rpx;
}

.cancel-notice-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #C2410C;
  margin-bottom: 8rpx;
}

.cancel-notice-reason {
  font-size: 26rpx;
  color: #9A3412;
  margin-bottom: 6rpx;
}

.cancel-notice-desc {
  font-size: 24rpx;
  color: #C2410C;
  opacity: 0.8;
}

/* 详情卡片 */
.detail-card {
  margin: 0 30rpx 24rpx;
  padding: 28rpx 32rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #1A1A1A;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 16rpx 0;
}

.detail-label {
  font-size: 26rpx;
  color: #999999;
  flex-shrink: 0;
  margin-right: 30rpx;
}

.detail-value {
  font-size: 26rpx;
  color: #333333;
  text-align: right;
  flex: 1;
}

.order-id-text {
  font-size: 22rpx;
  color: #999999;
}

/* 护航信息 */
.escort-info {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 16rpx 0;
}

.escort-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.escort-detail {
  flex: 1;
  min-width: 0;
}

.escort-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #1A1A1A;
  margin-bottom: 8rpx;
}

.escort-meta {
  font-size: 24rpx;
  color: #999999;
}

.escort-intro {
  padding: 20rpx 0;
  border-top: 1rpx solid #F5F5F5;
  margin-top: 12rpx;
}

.intro-label {
  font-size: 26rpx;
  color: #999999;
  display: block;
  margin-bottom: 8rpx;
}

.intro-text {
  font-size: 26rpx;
  color: #333333;
  line-height: 1.6;
}

.escort-extra {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx 0;
  padding-top: 16rpx;
  border-top: 1rpx solid #F5F5F5;
  margin-top: 12rpx;
}

.extra-item {
  width: 50%;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.extra-label {
  font-size: 22rpx;
  color: #999999;
}

.extra-value {
  font-size: 26rpx;
  color: #333333;
}

.remark-text {
  font-size: 26rpx;
  color: #666666;
  line-height: 44rpx;
}

/* 合计行 */
.total-row {
  margin-top: 12rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #F0F0F0;
}

.total-row .detail-label {
  font-size: 28rpx;
  color: #1A1A1A;
  font-weight: bold;
}

.total-price {
  display: flex;
  align-items: baseline;
}

.total-symbol {
  font-size: 26rpx;
  color: #FF6B6B;
  font-weight: bold;
}

.total-num {
  font-size: 44rpx;
  color: #FF6B6B;
  font-weight: bold;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  padding: 16rpx 30rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(20px);
  border-top: 1rpx solid #EEEEEE;
}

.bottom-btn-kefu {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 24rpx;
  background: transparent;
  border: none;
  line-height: normal;
  margin: 0;
}

.bottom-btn-kefu::after {
  border: none;
}

.kefu-icon {
  font-size: 32rpx;
}

.kefu-text {
  font-size: 20rpx;
  color: #999999;
  margin-top: 4rpx;
}

.bottom-btn-cancel {
  flex: 1;
  padding: 24rpx 0;
  text-align: center;
  background: #F5F5F7;
  border-radius: 44rpx;
  font-size: 30rpx;
  color: #666666;
  font-weight: 500;
}

.bottom-btn-cancel:active {
  opacity: 0.7;
}

.bottom-btn-confirm {
  flex: 1;
  padding: 24rpx 0;
  text-align: center;
  background: linear-gradient(90deg, #10B981, #34D399);
  border-radius: 44rpx;
  font-size: 30rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.bottom-btn-confirm:active {
  opacity: 0.8;
}

/* ===== 支付方式选择弹窗 ===== */
.pay-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s;
}

.pay-mask.show {
  opacity: 1;
  visibility: visible;
}

.pay-popup {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  padding: 30rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform 0.3s;
}

.pay-mask.show .pay-popup {
  transform: translateY(0);
}

.pay-popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.pay-popup-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1A1A1A;
}

.pay-popup-close {
  font-size: 40rpx;
  color: #999999;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pay-popup-amount {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 10rpx;
  padding: 20rpx 0 30rpx;
}

.pay-popup-amount-label {
  font-size: 28rpx;
  color: #666666;
}

.pay-popup-amount-val {
  font-size: 48rpx;
  font-weight: bold;
  color: #FF4D4F;
}

.pay-method-list {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  background: #F5F5F7;
  border-radius: 16rpx;
  overflow: hidden;
}

.pay-method-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  padding: 28rpx 24rpx;
}

.pay-method-item:active {
  background: #F9F9FA;
}

.pay-method-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.pay-method-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.pay-method-icon.wallet {
  background: #FFF3E0;
}

.pay-method-icon.wechat {
  background: #E8F5E9;
}

.pay-method-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.pay-method-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #1A1A1A;
}

.pay-method-desc {
  font-size: 24rpx;
  color: #999999;
}

.pay-method-arrow {
  font-size: 36rpx;
  color: #CCCCCC;
}
