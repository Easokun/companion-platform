/* pages/joinApply/joinApply.wxss */
.page-container {
  min-height: 100vh;
  background: #F5F5F7;
  padding-bottom: env(safe-area-inset-bottom);
}

.status-bar {
  width: 100%;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: #FFFFFF;
}

.nav-back {
  font-size: 48rpx;
  color: #333333;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333333;
}

/* 表单卡片 */
.form-card {
  margin: 24rpx 30rpx;
  padding: 28rpx 32rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1A1A1A;
  margin-bottom: 8rpx;
}

.card-tip {
  font-size: 22rpx;
  font-weight: normal;
  color: #999999;
  margin-left: 12rpx;
}

.form-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #1A1A1A;
  margin-bottom: 16rpx;
}

.required {
  color: #FF6B6B;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  background: #F5F5F7;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333333;
}

/* 单选 */
.radio-group {
  display: flex;
  gap: 40rpx;
  padding: 8rpx 0;
}

.radio-label {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #333333;
}

.radio-label radio {
  transform: scale(0.9);
  margin-right: 8rpx;
}

/* 城市选择 */
.picker-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 80rpx;
  padding: 0 24rpx;
  background: #F5F5F7;
  border-radius: 12rpx;
}

.picker-text {
  font-size: 28rpx;
  color: #333333;
}

.picker-placeholder {
  font-size: 28rpx;
  color: #BBBBBB;
}

.picker-arrow {
  font-size: 36rpx;
  color: #999999;
}

/* 考核说明 */
.exam-desc {
  font-size: 22rpx;
  color: #999999;
  margin-top: 12rpx;
}

/* 照片上传 */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 16rpx;
}

.photo-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.photo-img {
  width: 100%;
  height: 100%;
}

.photo-delete {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  border-radius: 0 12rpx 0 12rpx;
}

.photo-add {
  width: 160rpx;
  height: 160rpx;
  background: #F5F5F7;
  border: 2rpx dashed #CCCCCC;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.photo-add-icon {
  font-size: 56rpx;
  color: #CCCCCC;
  line-height: 1;
}

.photo-add-text {
  font-size: 22rpx;
  color: #999999;
  margin-top: 8rpx;
}

.photo-add:active {
  background: #EFEFF5;
}

/* 提交按钮 */
.submit-btn {
  margin: 40rpx 30rpx;
  padding: 28rpx 0;
  background: linear-gradient(135deg, #7B61FF, #A78BFA);
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #FFFFFF;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(123, 97, 255, 0.4);
}

.submit-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}
