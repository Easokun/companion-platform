<!--pages/joinApply/joinApply.wxml-->
<view class="page-container">
  <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>

  <!-- 导航栏 -->
  <view class="nav-bar">
    <view class="nav-back" bindtap="goBack">‹</view>
    <text class="nav-title">成为护航申请</text>
    <view style="width: 60rpx;"></view>
  </view>

  <!-- 基础信息 -->
  <view class="form-card">
    <view class="card-title">基础信息</view>

    <view class="form-item">
      <view class="form-label">真实姓名 <text class="required">*</text></view>
      <input class="form-input" placeholder="请输入真实姓名" value="{{realName}}" bindinput="onNameInput" />
    </view>

    <view class="form-item">
      <view class="form-label">性别 <text class="required">*</text></view>
      <radio-group class="radio-group" bindchange="onGenderChange">
        <label class="radio-label">
          <radio value="男" color="#7B61FF" />男
        </label>
        <label class="radio-label">
          <radio value="女" color="#7B61FF" />女
        </label>
      </radio-group>
    </view>

    <view class="form-item">
      <view class="form-label">所在城市 <text class="required">*</text></view>
      <picker mode="selector" range="{{cityColumns}}" bindchange="onCityChange">
        <view class="picker-box">
          <text class="{{city ? 'picker-text' : 'picker-placeholder'}}">{{city || '请选择城市'}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>
  </view>

  <!-- 联系方式 -->
  <view class="form-card">
    <view class="card-title">联系方式</view>

    <view class="form-item">
      <view class="form-label">QQ</view>
      <input class="form-input" placeholder="请输入QQ号" value="{{qq}}" bindinput="onQqInput" />
    </view>

    <view class="form-item">
      <view class="form-label">微信</view>
      <input class="form-input" placeholder="请输入微信号" value="{{wechat}}" bindinput="onWechatInput" />
    </view>

    <view class="form-item">
      <view class="form-label">手机号 <text class="required">*</text></view>
      <input class="form-input" type="number" placeholder="请输入手机号" value="{{phone}}" bindinput="onPhoneInput" maxlength="11" />
    </view>

    <view class="form-item">
      <view class="form-label">联系邮箱</view>
      <input class="form-input" placeholder="请输入邮箱" value="{{email}}" bindinput="onEmailInput" />
    </view>
  </view>

  <!-- 上传照片 -->
  <view class="form-card">
    <view class="card-title">游戏信息</view>

    <view class="form-item">
      <view class="form-label">游戏段位 <text class="required">*</text></view>
      <input class="form-input" placeholder="请输入游戏段位/等级" value="{{gameLevel}}" bindinput="onGameLevelInput" />
    </view>

    <view class="form-label" style="margin-top: 20rpx;">游戏水平截图 <text class="required">*</text></view>
    <view class="card-tip" style="margin-bottom: 16rpx;">支持 png、jpg 格式，最多{{photoMax}}张</view>
    <view class="photo-grid">
      <view class="photo-item" wx:for="{{photos}}" wx:key="*this" data-index="{{index}}">
        <image class="photo-img" src="{{item}}" mode="aspectFill" data-index="{{index}}" bindtap="previewPhoto"></image>
        <view class="photo-delete" data-index="{{index}}" catchtap="deletePhoto">✕</view>
      </view>
      <view class="photo-add" wx:if="{{photos.length < photoMax}}" bindtap="choosePhoto">
        <text class="photo-add-icon">+</text>
        <text class="photo-add-text">上传</text>
      </view>
    </view>
  </view>

  <!-- 是否参加考核 -->
  <view class="form-card">
    <view class="card-title">考核</view>
    <view class="form-item">
      <view class="form-label">是否参加考核 <text class="required">*</text></view>
      <radio-group class="radio-group" bindchange="onExamChange">
        <label class="radio-label">
          <radio value="是" color="#7B61FF" />参加
        </label>
        <label class="radio-label">
          <radio value="否" color="#7B61FF" />不参加
        </label>
      </radio-group>
      <view class="exam-desc">参加考核通过后可获得认证标识，优先派单</view>
    </view>
  </view>

  <!-- 提交申请 -->
  <view class="submit-btn" bindtap="submitApply">提交申请</view>

  <view style="height: 80rpx;"></view>
</view>
