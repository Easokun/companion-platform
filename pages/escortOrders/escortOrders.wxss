/* pages/escortOrders/escortOrders.wxss */
.page-container {
  min-height: 100vh;
  background: #F5F5F7;
  padding-bottom: env(safe-area-inset-bottom);
}

.status-bar {
  width: 100%;
  background: #FFFFFF;
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: #FFFFFF;
}

.nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #333333;
}

.nav-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333333;
}

/* 筛选标签 */
.tab-bar {
  display: flex;
  background: #FFFFFF;
  border-bottom: 1rpx solid #F0F0F0;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 28rpx;
  color: #666666;
  position: relative;
}

.tab-item.active {
  color: #7B61FF;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: linear-gradient(90deg, #7B61FF, #A78BFA);
  border-radius: 3rpx;
}

.list-container {
  padding: 20rpx 24rpx;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 30rpx;
  color: #999999;
}

/* 订单列表 */
.order-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.order-card {
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F5F5F7;
}

.order-status {
  font-size: 26rpx;
  font-weight: 500;
}

.order-status.status-1 { color: #3B82F6; }
.order-status.status-5 { color: #FA8C16; }
.order-status.status-2 { color: #10B981; }
.order-status.status-4 { color: #9CA3AF; }

.order-time {
  font-size: 22rpx;
  color: #BBBBBB;
}

.order-body {
  margin-bottom: 16rpx;
}

.order-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #1A1A1A;
  margin-bottom: 8rpx;
}

.order-desc {
  font-size: 24rpx;
  color: #999999;
  line-height: 36rpx;
}

.order-user {
  padding: 16rpx 20rpx;
  background: #F9FAFB;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.user-row {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
}

.user-label {
  font-size: 24rpx;
  color: #999999;
}

.user-value {
  font-size: 24rpx;
  color: #333333;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.team-badge {
  padding: 6rpx 16rpx;
  background: #F0EDFF;
  color: #7B61FF;
  font-size: 22rpx;
  border-radius: 8rpx;
}

.order-price {
  display: flex;
  align-items: baseline;
}

.price-label {
  font-size: 22rpx;
  color: #999999;
  margin-right: 8rpx;
}

.price-symbol {
  font-size: 24rpx;
  color: #10B981;
  font-weight: bold;
}

.price-num {
  font-size: 36rpx;
  color: #10B981;
  font-weight: bold;
}

.order-actions {
  display: flex;
  gap: 16rpx;
}

.btn-contact, .btn-complete {
  padding: 14rpx 28rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
}

.btn-contact {
  background: #F5F5F7;
  color: #666666;
  border: 1rpx solid #E5E7EB;
}

.btn-complete {
  background: linear-gradient(135deg, #10B981, #34D399);
  color: #FFFFFF;
  font-weight: 500;
}
