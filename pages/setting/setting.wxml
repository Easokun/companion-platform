<!--pages/setting/setting.wxml-->
<view class="page-container">
  <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>

  <!-- 导航栏 -->
  <view class="nav-bar">
    <view class="nav-back" bindtap="goBack">‹</view>
    <text class="nav-title">设置</text>
    <view style="width: 60rpx;"></view>
  </view>

  <!-- 通知设置 -->
  <view class="section-card">
    <view class="section-title">消息通知</view>
    <view class="setting-item">
      <view class="setting-text">订单通知</view>
      <switch class="setting-switch" checked="{{notifyOrder}}" bindchange="switchOrderNotify" color="#7B61FF" />
    </view>
    <view class="setting-divider"></view>
    <view class="setting-item">
      <view class="setting-text">消息通知</view>
      <switch class="setting-switch" checked="{{notifyMessage}}" bindchange="switchMessageNotify" color="#7B61FF" />
    </view>
  </view>

  <!-- 通用设置 -->
  <view class="section-card">
    <view class="section-title">通用</view>
    <view class="setting-item" bindtap="clearCache">
      <view class="setting-text">清除缓存</view>
      <view class="setting-right">
        <text class="setting-value">{{cacheSize}}</text>
        <text class="setting-arrow">›</text>
      </view>
    </view>
    <view class="setting-divider"></view>
    <view class="setting-item" bindtap="checkUpdate">
      <view class="setting-text">检查更新</view>
      <view class="setting-right">
        <text class="setting-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 其他 -->
  <view class="section-card">
    <view class="section-title">其他</view>
    <view class="setting-item" bindtap="goFeedback">
      <view class="setting-text">意见反馈</view>
      <view class="setting-right">
        <text class="setting-arrow">›</text>
      </view>
    </view>
    <view class="setting-divider"></view>
    <view class="setting-item" bindtap="goAbout">
      <view class="setting-text">关于我们</view>
      <view class="setting-right">
        <text class="setting-arrow">›</text>
      </view>
    </view>
  </view>
</view>
