<!--pages/wallet/wallet.wxml-->
<view class="page-container">
  <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>

  <!-- 导航栏 -->
  <view class="nav-bar">
    <view class="nav-back" bindtap="goBack">‹</view>
    <text class="nav-title">我的钱包</text>
    <view style="width: 60rpx;"></view>
  </view>

  <!-- 余额卡片 -->
  <view class="balance-card">
    <view class="balance-label">账户余额</view>
    <view class="balance-amount">
      <text class="balance-symbol">¥</text>
      <text class="balance-num">{{balance}}</text>
    </view>
    <view class="balance-stats">
      <view class="stat-item">
        <view class="stat-val">¥{{totalRecharge}}</view>
        <view class="stat-label">累计充值</view>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <view class="stat-val">¥{{totalSpend}}</view>
        <view class="stat-label">累计消费</view>
      </view>
    </view>
  </view>

  <!-- 充值区 -->
  <view class="recharge-section">
    <view class="section-title">选择充值金额</view>
    <view class="amount-grid">
      <view 
        class="amount-item {{amount == '50' ? 'active' : ''}}" 
        data-amount="50"
        bindtap="selectAmount"
      >50</view>
      <view 
        class="amount-item {{amount == '100' ? 'active' : ''}}" 
        data-amount="100"
        bindtap="selectAmount"
      >100</view>
      <view 
        class="amount-item {{amount == '200' ? 'active' : ''}}" 
        data-amount="200"
        bindtap="selectAmount"
      >200</view>
      <view 
        class="amount-item {{amount == '500' ? 'active' : ''}}" 
        data-amount="500"
        bindtap="selectAmount"
      >500</view>
    </view>

    <view class="section-title" style="margin-top: 40rpx;">自定义金额</view>
    <view class="input-box">
      <text class="input-symbol">¥</text>
      <input 
        class="amount-input" 
        type="digit" 
        placeholder="请输入金额" 
        value="{{amount}}"
        bindinput="onAmountInput"
      />
    </view>

    <view class="recharge-btn" bindtap="recharge">充值</view>
  </view>

  <!-- 流水记录 -->
  <view class="flow-section">
    <view class="section-title">
      <text>余额流水</text>
      <text class="flow-total">共{{flowTotal}}条</text>
    </view>

    <view wx:if="{{flowList.length > 0}}" class="flow-list">
      <view 
        class="flow-item" 
        wx:for="{{flowList}}" 
        wx:key="id"
      >
        <view class="flow-left">
          <view class="flow-title">{{item.title}}</view>
          <view class="flow-time">{{item.timeStr}}</view>
        </view>
        <view class="flow-right">
          <text class="flow-amount {{item.isIncome ? 'income' : 'expense'}}">{{item.amountStr}}</text>
          <view class="flow-balance">余额：¥{{item.balanceAfter}}</view>
        </view>
      </view>

      <view wx:if="{{loadingFlows}}" class="flow-loading">加载中...</view>
      <view wx:elif="{{!hasMoreFlows && flowList.length > 0}}" class="flow-end">- 没有更多了 -</view>
    </view>

    <view wx:elif="{{!loadingFlows}}" class="flow-empty">
      <text>暂无流水记录</text>
    </view>
  </view>
</view>
