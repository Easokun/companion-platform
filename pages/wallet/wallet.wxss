/* pages/wallet/wallet.wxss */
.page-container {
  min-height: 100vh;
  background: #F5F5F7;
  padding-bottom: 60rpx;
}

.status-bar {
  width: 100%;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: #FFFFFF;
}

.nav-back {
  font-size: 48rpx;
  color: #333333;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333333;
}

/* 余额卡片 */
.balance-card {
  margin: 30rpx;
  padding: 50rpx;
  background: linear-gradient(135deg, #7B61FF, #A78BFA);
  border-radius: 24rpx;
  text-align: center;
}

.balance-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 16rpx;
}

.balance-amount {
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.balance-symbol {
  font-size: 36rpx;
  color: #FFFFFF;
  font-weight: bold;
}

.balance-num {
  font-size: 72rpx;
  color: #FFFFFF;
  font-weight: bold;
  margin-left: 8rpx;
}

.balance-stats {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 36rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-val {
  font-size: 30rpx;
  font-weight: bold;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.3);
}

/* 充值区 */
.recharge-section {
  margin: 0 30rpx 30rpx;
  padding: 30rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #1A1A1A;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.amount-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}

.amount-item {
  padding: 30rpx 0;
  text-align: center;
  background: #F5F5F7;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  transition: all 0.2s;
}

.amount-item.active {
  background: rgba(123, 97, 255, 0.1);
  color: #7B61FF;
  border: 2rpx solid #7B61FF;
}

.input-box {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  background: #F5F5F7;
  border-radius: 16rpx;
  margin-bottom: 40rpx;
}

.input-symbol {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
  margin-right: 8rpx;
}

.amount-input {
  flex: 1;
  font-size: 32rpx;
  color: #333333;
}

.recharge-btn {
  width: 100%;
  padding: 28rpx 0;
  background: linear-gradient(135deg, #07C160, #04BE02);
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #FFFFFF;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(7, 193, 96, 0.3);
}

.recharge-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

/* 流水区 */
.flow-section {
  margin: 0 30rpx;
  padding: 30rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
}

.flow-total {
  font-size: 24rpx;
  font-weight: normal;
  color: #999999;
}

.flow-list {
  margin-top: 10rpx;
}

.flow-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.flow-item:last-child {
  border-bottom: none;
}

.flow-left {
  flex: 1;
  overflow: hidden;
}

.flow-title {
  font-size: 28rpx;
  color: #1A1A1A;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.flow-time {
  font-size: 22rpx;
  color: #999999;
}

.flow-right {
  text-align: right;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.flow-amount {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 6rpx;
}

.flow-amount.income {
  color: #07C160;
}

.flow-amount.expense {
  color: #FF4D4F;
}

.flow-balance {
  font-size: 22rpx;
  color: #999999;
}

.flow-loading,
.flow-end {
  text-align: center;
  padding: 30rpx 0 10rpx;
  font-size: 24rpx;
  color: #999999;
}

.flow-empty {
  text-align: center;
  padding: 60rpx 0;
  font-size: 26rpx;
  color: #BBBBBB;
}
