/* pages/index/index.wxss */
.page-container {
  min-height: 100vh;
  background: #FFFFFF;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* 状态栏占位 */
.status-bar {
  width: 100%;
}

/* 公告条 */
.notice-bar {
  display: flex;
  align-items: center;
  margin: 20rpx 30rpx 0;
  padding: 16rpx 24rpx;
  background: linear-gradient(135deg, rgba(123, 97, 255, 0.06), rgba(167, 139, 250, 0.04));
  border: 1rpx solid rgba(123, 97, 255, 0.15);
  border-radius: 16rpx;
}

.notice-icon {
  font-size: 28rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

/* 轮播图 */
.banner-section {
  margin: 20rpx 30rpx 0;
  border-radius: 16rpx;
  overflow: hidden;
}

.banner-swiper {
  width: 100%;
  height: 280rpx;
}

.banner-image {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
}

.notice-scroll {
  flex: 1;
  overflow: hidden;
  height: 40rpx;
  display: flex;
  align-items: center;
}

.notice-text {
  color: #7B61FF;
  font-size: 26rpx;
  white-space: nowrap;
  line-height: 40rpx;
}

/* Logo 区域 */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 30rpx;
}

.logo-box {
  width: calc(100% - 60rpx);
  margin: 0 30rpx;
  height: 320rpx;
  border-radius: 28rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.logo-img {
  width: 100%;
  height: 100%;
}

.logo-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #1A1A1A;
  letter-spacing: 4rpx;
}

.logo-subtitle {
  font-size: 26rpx;
  color: #999999;
  margin-top: 12rpx;
  letter-spacing: 2rpx;
}

/* 功能按钮网格 */
.feature-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
  margin: 30rpx;
  padding: 30rpx;
  background: #F5F5F7;
  border-radius: 24rpx;
  border: 1rpx solid #EEEEEE;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: transform 0.2s ease;
}

.feature-item:active {
  transform: scale(0.92);
}

.feature-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.feature-name {
  font-size: 24rpx;
  color: #666666;
}

/* 火热标签区 */
.hot-tags-section {
  margin: 0 30rpx 30rpx;
  padding: 30rpx;
  background: linear-gradient(135deg, rgba(123, 97, 255, 0.04), rgba(167, 139, 250, 0.02));
  border: 1rpx solid rgba(123, 97, 255, 0.1);
  border-radius: 24rpx;
}

/* 居中趣味标题 */
.hot-title-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.hot-title-line {
  width: 60rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #FFA500);
}

.hot-title-bar .hot-title-line:last-of-type {
  background: linear-gradient(90deg, #FFA500, transparent);
}

.hot-title-icon {
  font-size: 28rpx;
  margin: 0 8rpx;
  animation: fireBlink 1.5s ease-in-out infinite;
}

.hot-title-text {
  font-size: 30rpx;
  font-weight: bold;
  color: #1A1A1A;
  margin: 0 8rpx;
  background: linear-gradient(135deg, #FF6B6B, #FFA500);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

@keyframes fireBlink {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.6; transform: scale(0.9); }
}

.hot-tags {
  display: flex;
  white-space: nowrap;
  margin-top: 20rpx;
}

.hot-tag {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  background: #F5F5F7;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666666;
  font-weight: 500;
  flex-shrink: 0;
  transition: all 0.2s;
}

.hot-tag.active {
  background: linear-gradient(135deg, #FFD700, #FFA500);
  color: #1A1A1A;
  font-weight: bold;
  box-shadow: 0 4rpx 16rpx rgba(255, 165, 0, 0.3);
}

/* 区域标题 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 0 30rpx 24rpx;
}

.section-title {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #1A1A1A;
}

.title-dot {
  width: 8rpx;
  height: 32rpx;
  background: linear-gradient(180deg, #7B61FF, #A78BFA);
  border-radius: 4rpx;
  margin-right: 16rpx;
}

.section-more {
  font-size: 24rpx;
  color: #7B61FF;
}

.section-more:active {
  opacity: 0.7;
}

/* 服务卡片网格 */
.service-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin: 0 30rpx;
}

.service-card {
  width: 48%;
  margin-bottom: 24rpx;
  background: #FFFFFF;
  border: 1rpx solid #EEEEEE;
  border-radius: 24rpx;
  overflow: hidden;
  transition: all 0.2s ease;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.service-card.active {
  transform: scale(0.97);
  border-color: rgba(123, 97, 255, 0.25);
  box-shadow: 0 4rpx 20rpx rgba(123, 97, 255, 0.1);
}

.card-image-box {
  position: relative;
  width: 100%;
  height: 200rpx;
  overflow: hidden;
}

.card-image {
  width: 100%;
  height: 100%;
}

.card-tag {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  color: #FFFFFF;
}

.card-info {
  padding: 20rpx;
}

.card-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #1A1A1A;
  margin-bottom: 6rpx;
}

.card-desc {
  font-size: 22rpx;
  color: #999999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-price {
  display: flex;
  align-items: baseline;
  margin-top: 10rpx;
}

.card-price-symbol {
  font-size: 22rpx;
  color: #FF6B6B;
  font-weight: bold;
}

.card-price-num {
  font-size: 34rpx;
  color: #FF6B6B;
  font-weight: bold;
  margin-left: 2rpx;
}

/* 卡片底部操作区（客服+收藏） */
.card-actions {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #F0F0F0;
}

.card-action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 0;
  border-radius: 12rpx;
  transition: all 0.15s;
}

.card-action-btn:active {
  background: #F5F5F7;
}

.card-action-icon {
  font-size: 22rpx;
  margin-right: 4rpx;
}

.card-action-text {
  font-size: 20rpx;
  color: #999999;
}

/* 底部留白 */
.bottom-space {
  height: 60rpx;
}

/* 功能弹窗 */
.feature-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.feature-modal {
  width: 600rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
}

.feature-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.feature-modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1A1A1A;
}

.feature-modal-close {
  font-size: 32rpx;
  color: #999999;
  padding: 10rpx;
}

.feature-modal-body {
  padding: 40rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 300rpx;
}

.feature-modal-image {
  width: 100%;
  height: 400rpx;
}

.feature-modal-text {
  font-size: 32rpx;
  color: #999999;
  text-align: center;
}

