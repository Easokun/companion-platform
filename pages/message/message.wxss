/* pages/message/message.wxss */
.page-container {
  min-height: 100vh;
  background: #F7F8FA;
  display: flex;
  flex-direction: column;
}

.status-bar {
  width: 100%;
  background: #FFFFFF;
  flex-shrink: 0;
}

/* ========== 搜索栏 ========== */
.search-bar {
  padding: 20rpx 32rpx 24rpx;
  background: #FFFFFF;
  flex-shrink: 0;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background: #F5F5F7;
  border-radius: 40rpx;
  padding: 16rpx 28rpx;
  transition: all 0.3s ease;
  border: 2rpx solid transparent;
}

.search-input-wrap.focused {
  background: #FFFFFF;
  border-color: #FF6B6B;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 107, 0.15);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  opacity: 0.6;
  transition: all 0.3s ease;
}

.search-input-wrap.focused .search-icon {
  opacity: 1;
  transform: scale(1.1);
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.search-placeholder {
  color: #999999;
  font-size: 28rpx;
}

.search-clear {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #CCCCCC;
  border-radius: 50%;
  margin-left: 12rpx;
  transition: all 0.2s ease;
}

.search-clear:active {
  transform: scale(0.9);
  background: #999999;
}

.search-clear text {
  font-size: 22rpx;
  color: #FFFFFF;
  line-height: 1;
}

/* ========== 搜索结果 ========== */
.search-result {
  flex: 1;
  padding: 20rpx;
  box-sizing: border-box;
}

.result-header {
  margin-bottom: 20rpx;
  padding-left: 8rpx;
}

.result-count {
  font-size: 26rpx;
  color: #666666;
}

/* 搜索空状态 */
.search-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
}

.search-empty .empty-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.search-empty .empty-text {
  font-size: 30rpx;
  color: #333333;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.search-empty .empty-desc {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 30rpx;
}

.empty-tags {
  display: flex;
  gap: 20rpx;
}

.empty-tag {
  padding: 12rpx 28rpx;
  background: #FFFFFF;
  border: 2rpx solid #EEEEEE;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #666666;
  transition: all 0.2s ease;
}

.empty-tag:active {
  background: #FFF0F0;
  border-color: #FF6B6B;
  color: #FF6B6B;
  transform: scale(0.95);
}

/* ========== 主体内容 ========== */
.main-content {
  flex: 1;
  display: flex;
  overflow: hidden;
}

/* ========== 左侧导航 ========== */
.left-nav {
  width: 180rpx;
  background: #FFFFFF;
  height: 100%;
}

.nav-item {
  position: relative;
  padding: 32rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #666666;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.nav-item:active {
  background: #FAFAFA;
}

.nav-item.active {
  background: #F7F8FA;
  color: #1A1A1A;
  font-weight: bold;
}

.nav-icon {
  font-size: 36rpx;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.nav-item.active .nav-icon {
  transform: scale(1.15);
}

.nav-indicator {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 48rpx;
  background: linear-gradient(180deg, #FF6B6B, #FF8E8E);
  border-radius: 0 6rpx 6rpx 0;
  animation: indicatorSlide 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes indicatorSlide {
  from {
    opacity: 0;
    transform: translateY(-50%) scaleY(0.5);
  }
  to {
    opacity: 1;
    transform: translateY(-50%) scaleY(1);
  }
}

/* ========== 右侧内容区 ========== */
.right-content {
  flex: 1;
  padding: 20rpx;
  height: 100%;
  box-sizing: border-box;
}

/* ========== 分类标题 ========== */
.category-header {
  margin-bottom: 24rpx;
  padding-left: 8rpx;
}

.category-title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.category-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #1A1A1A;
  letter-spacing: 2rpx;
}

.title-decor {
  flex: 1;
  height: 4rpx;
  background: linear-gradient(90deg, #FF6B6B, transparent);
  border-radius: 2rpx;
  max-width: 100rpx;
}

.category-sub {
  font-size: 22rpx;
  color: #999999;
}

/* ========== 服务列表 ========== */
.service-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.service-item {
  display: flex;
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
}

.service-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(255, 107, 107, 0.05), rgba(255, 142, 142, 0.05));
  opacity: 0;
  transition: opacity 0.25s ease;
  pointer-events: none;
}

.service-item.touched {
  transform: scale(0.97);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.service-item.touched::before {
  opacity: 1;
}

.service-img-wrap {
  width: 200rpx;
  height: 200rpx;
  position: relative;
  flex-shrink: 0;
  overflow: hidden;
}

.service-img {
  width: 100%;
  height: 100%;
  transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.service-item.touched .service-img {
  transform: scale(1.05);
}

.img-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, transparent 50%, rgba(0, 0, 0, 0.1));
  pointer-events: none;
}

.service-tag {
  position: absolute;
  top: 16rpx;
  left: 0;
  padding: 6rpx 18rpx 6rpx 14rpx;
  font-size: 20rpx;
  color: #FFFFFF;
  border-radius: 0 20rpx 20rpx 0;
  font-weight: 500;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 4rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

.tag-dot {
  font-size: 16rpx;
  opacity: 0.8;
}

.service-info {
  flex: 1;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.service-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #1A1A1A;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.service-desc {
  font-size: 22rpx;
  color: #999999;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.service-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.service-price {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  font-size: 22rpx;
  color: #FF6B6B;
  font-weight: bold;
}

.price-num {
  font-size: 36rpx;
  color: #FF6B6B;
  font-weight: bold;
  margin-left: 2rpx;
}

.price-unit {
  font-size: 20rpx;
  color: #FF6B6B;
  margin-left: 4rpx;
}

.service-btn {
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  color: #FFFFFF;
  font-size: 22rpx;
  padding: 12rpx 20rpx 12rpx 28rpx;
  border-radius: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  gap: 6rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 107, 0.3);
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}

.service-item.touched .service-btn {
  transform: scale(0.95);
  box-shadow: 0 2rpx 6rpx rgba(255, 107, 107, 0.3);
}

.btn-arrow {
  font-size: 24rpx;
  transition: transform 0.25s ease;
}

.service-item.touched .btn-arrow {
  transform: translateX(4rpx);
}
