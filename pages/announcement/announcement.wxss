/* pages/announcement/announcement.wxss */
.page-container {
  height: 100vh;
  background: #F5F5F7;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.status-bar {
  width: 100%;
  flex-shrink: 0;
  background: linear-gradient(135deg, #7B61FF, #A78BFA);
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: linear-gradient(135deg, #7B61FF, #A78BFA);
  flex-shrink: 0;
}

.nav-back {
  font-size: 48rpx;
  color: #FFFFFF;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #FFFFFF;
}

.content-scroll {
  flex: 1;
  height: 0;
  padding: 20rpx;
  box-sizing: border-box;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  gap: 20rpx;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}

/* 公告卡片 */
.announcement-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.ann-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.ann-tag {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  flex-shrink: 0;
}

.ann-tag.unread {
  background: #FEF3C7;
  color: #D97706;
}

.ann-tag.read {
  background: #F3F4F6;
  color: #9CA3AF;
}

.ann-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1A1A1A;
  flex: 1;
}

.ann-content {
  font-size: 28rpx;
  color: #4B5563;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.ann-footer {
  display: flex;
  justify-content: flex-end;
}

.ann-time {
  font-size: 22rpx;
  color: #9CA3AF;
}
