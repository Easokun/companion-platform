<!--pages/announcement/announcement.wxml-->
<view class="page-container">
  <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>

  <!-- 顶部导航 -->
  <view class="nav-bar">
    <view class="nav-back" bindtap="goBack">‹</view>
    <text class="nav-title">接单公告</text>
    <view style="width: 60rpx;"></view>
  </view>

  <!-- 公告列表 -->
  <scroll-view class="content-scroll" scroll-y>
    <view wx:if="{{announcements.length === 0 && !loading}}" class="empty-state">
      <text class="empty-icon">📭</text>
      <text class="empty-text">暂无公告</text>
    </view>

    <view wx:for="{{announcements}}" wx:key="id" class="announcement-card" data-id="{{item.id}}" bindtap="onTapAnnouncement">
      <view class="ann-header">
        <view class="ann-tag {{item.isRead ? 'read' : 'unread'}}">
          <text>{{item.isRead ? '已读' : '新'}}</text>
        </view>
        <text class="ann-title">{{item.title}}</text>
      </view>
      <view class="ann-content">{{item.content}}</view>
      <view class="ann-footer">
        <text class="ann-time">{{item.createTimeText}}</text>
      </view>
    </view>

    <view style="height: 40rpx;"></view>
  </scroll-view>
</view>
