/* pages/invite/invite.wxss */
.page-container {
  min-height: 100vh;
  background: #F5F5F7;
  padding-bottom: 40rpx;
}

.status-bar {
  width: 100%;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: #FFFFFF;
}

.nav-back {
  font-size: 48rpx;
  color: #333333;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333333;
}

/* 邀请卡片 */
.invite-card {
  margin: 30rpx;
  padding: 50rpx 40rpx;
  background: linear-gradient(135deg, #7B61FF, #A78BFA);
  border-radius: 24rpx;
  text-align: center;
}

.invite-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #FFFFFF;
  margin-bottom: 16rpx;
}

.invite-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-bottom: 40rpx;
}

.invite-reward {
  display: flex;
  justify-content: center;
  align-items: center;
}

.reward-item {
  flex: 1;
}

.reward-num {
  font-size: 48rpx;
  font-weight: bold;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.reward-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.reward-divider {
  width: 2rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.3);
}

/* 邀请码 */
.code-section {
  margin: 0 30rpx 30rpx;
  padding: 30rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #1A1A1A;
  margin-bottom: 24rpx;
}

.code-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
  background: #F5F5F7;
  border-radius: 16rpx;
  border: 2rpx dashed #7B61FF;
}

.code-text {
  font-size: 52rpx;
  font-weight: bold;
  color: #7B61FF;
  letter-spacing: 8rpx;
  margin-bottom: 12rpx;
}

.code-tip {
  font-size: 24rpx;
  color: #999999;
}

/* 分享按钮 */
.share-section {
  margin: 0 30rpx 30rpx;
  padding: 30rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
}

.share-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 30rpx;
  background: #F5F5F7;
  border-radius: 16rpx;
  border: none;
  width: 100%;
  margin: 0;
}

.share-btn::after {
  border: none;
}

.share-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}

.share-text {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

/* 规则说明 */
.rule-section {
  margin: 0 30rpx;
  padding: 30rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
}

.rule-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #1A1A1A;
  margin-bottom: 20rpx;
}

.rule-item {
  font-size: 26rpx;
  color: #666666;
  line-height: 48rpx;
}
