/* pages/escortProfile/escortProfile.wxss */
.page-container {
  height: 100vh;
  background: #F5F5F7;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.status-bar {
  width: 100%;
  flex-shrink: 0;
  background: linear-gradient(135deg, #7B61FF, #A78BFA);
}

.nav-bar {
  background: linear-gradient(135deg, #7B61FF, #A78BFA);
  flex-shrink: 0;
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
}

.nav-back {
  font-size: 48rpx;
  color: #FFFFFF;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #FFFFFF;
}

.content-scroll {
  flex: 1;
  height: 0;
}

/* 审核提示 */
.audit-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 20rpx;
  background: #FEF3C7;
}

.tip-icon {
  font-size: 32rpx;
}

.tip-text {
  font-size: 26rpx;
  color: #92400E;
}

/* 头像区 */
.profile-header {
  background: linear-gradient(135deg, #7B61FF, #A78BFA);
  padding: 30rpx 40rpx 50rpx;
  display: flex;
  align-items: center;
  gap: 30rpx;
}

.avatar-wrap {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  flex-shrink: 0;
}

.avatar-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
}

.avatar-edit {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 44rpx;
  height: 44rpx;
  background: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.header-info {
  flex: 1;
  min-width: 0;
}

.nickname-input {
  margin-bottom: 10rpx;
}

.nickname-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #FFFFFF;
}

.nickname-placeholder {
  color: rgba(255, 255, 255, 0.6);
  font-size: 36rpx;
}

.header-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 卡片通用 */
.section-card {
  background: #FFFFFF;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 28rpx;
}

.section-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: bold;
  color: #1A1A1A;
  margin-bottom: 24rpx;
}

.title-bar {
  width: 6rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #7B61FF, #A78BFA);
  border-radius: 4rpx;
  margin-right: 16rpx;
}

.section-tip {
  font-size: 22rpx;
  color: #999999;
  font-weight: normal;
  margin-left: auto;
}

/* 表单列表 */
.form-list {
  display: flex;
  flex-direction: column;
}

.form-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
  min-height: 60rpx;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 28rpx;
  color: #333333;
  flex-shrink: 0;
  width: 160rpx;
}

.form-input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #1A1A1A;
}

.form-value {
  font-size: 28rpx;
  color: #1A1A1A;
}

.intro-item {
  flex-direction: column;
  align-items: flex-start;
  position: relative;
}

.intro-item .form-label {
  margin-bottom: 16rpx;
  width: auto;
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  font-size: 28rpx;
  color: #1A1A1A;
  line-height: 1.6;
  padding: 20rpx;
  background: #F9FAFB;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.word-count {
  position: absolute;
  right: 0;
  bottom: 20rpx;
  font-size: 22rpx;
  color: #CCCCCC;
}

/* 单选 */
.radio-group {
  display: flex;
  gap: 40rpx;
}

.radio-label {
  font-size: 28rpx;
  color: #1A1A1A;
}

/* 选择器 */
.picker-box {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.picker-text {
  font-size: 28rpx;
  color: #1A1A1A;
}

.picker-arrow {
  font-size: 28rpx;
  color: #CCCCCC;
}

/* 服务标签 */
.service-item {
  flex-direction: column;
  align-items: flex-start;
}

.service-item .form-label {
  margin-bottom: 16rpx;
  width: auto;
}

.service-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.service-tag {
  padding: 14rpx 28rpx;
  background: #F5F5F7;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666666;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.service-tag.active {
  background: linear-gradient(135deg, rgba(123, 97, 255, 0.1), rgba(167, 139, 250, 0.1));
  color: #7B61FF;
  border-color: #7B61FF;
}

/* 照片网格 */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo-item {
  position: relative;
  width: calc((100% - 32rpx) / 3);
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.photo-img {
  width: 100%;
  height: 100%;
}

.photo-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 36rpx;
  height: 36rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #FFFFFF;
}

.photo-add {
  width: calc((100% - 32rpx) / 3);
  height: 200rpx;
  border: 2rpx dashed #DDDDDD;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: #FAFAFA;
}

.add-icon {
  font-size: 48rpx;
  color: #CCCCCC;
  line-height: 1;
}

.add-text {
  font-size: 22rpx;
  color: #999999;
}

/* 底部按钮 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  background: #FFFFFF;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.submit-btn {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: linear-gradient(135deg, #7B61FF, #A78BFA);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 44rpx;
  box-shadow: 0 4rpx 16rpx rgba(123, 97, 255, 0.3);
}

.submit-btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}
