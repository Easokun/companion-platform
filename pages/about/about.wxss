/* pages/about/about.wxss */
.page-container {
  min-height: 100vh;
  background: #F5F5F7;
  padding-bottom: 40rpx;
}

.status-bar {
  width: 100%;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: #FFFFFF;
}

.nav-back {
  font-size: 48rpx;
  color: #333333;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333333;
}

/* 头部 */
.about-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 30rpx 40rpx;
  background: #FFFFFF;
}

.about-logo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 40rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.about-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #1A1A1A;
  margin-bottom: 12rpx;
}

.about-slogan {
  font-size: 26rpx;
  color: #999999;
}

/* 卡片通用 */
.section-card {
  margin: 30rpx;
  padding: 0 30rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #1A1A1A;
  padding: 30rpx 0 20rpx;
}

.about-desc {
  font-size: 26rpx;
  color: #666666;
  line-height: 44rpx;
  padding-bottom: 30rpx;
}

/* 菜单项 */
.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 0;
}

.menu-text {
  font-size: 28rpx;
  color: #333333;
}

.menu-arrow {
  font-size: 32rpx;
  color: #CCCCCC;
}

.menu-divider {
  height: 1rpx;
  background: #F0F0F0;
}

/* 版本信息 */
.version-info {
  text-align: center;
  font-size: 24rpx;
  color: #CCCCCC;
  margin-top: 60rpx;
}

/* ICP备案 */
.icp-info {
  text-align: center;
  font-size: 22rpx;
  color: #BBBBBB;
  margin-top: 16rpx;
  padding-bottom: 40rpx;
}
