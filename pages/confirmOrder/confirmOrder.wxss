/* pages/confirmOrder/confirmOrder.wxss */
.page-container {
  min-height: 100vh;
  background: #F5F5F7;
  padding-bottom: env(safe-area-inset-bottom);
}

.status-bar {
  width: 100%;
  background: #FFFFFF;
}

/* 顶部导航 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 30rpx;
  position: relative;
  background: #FFFFFF;
}

.nav-close {
  position: absolute;
  left: 30rpx;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #333333;
}

.nav-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #1A1A1A;
}

/* 商品信息卡片 */
.goods-card {
  display: flex;
  margin: 20rpx 24rpx;
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
}

.goods-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.goods-info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}

.goods-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #1A1A1A;
  margin-bottom: 10rpx;
  line-height: 42rpx;
}

.goods-desc {
  font-size: 22rpx;
  color: #999999;
  line-height: 32rpx;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.goods-price {
  display: flex;
  align-items: baseline;
  margin-top: auto;
}

.price-symbol {
  font-size: 26rpx;
  color: #FF3B30;
  font-weight: bold;
}

.price-num {
  font-size: 40rpx;
  color: #FF3B30;
  font-weight: bold;
  margin: 0 2rpx;
}

/* 表单行 */
.form-row {
  margin: 0 24rpx;
  padding: 28rpx 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  margin-top: 16rpx;
}

.form-label {
  font-size: 28rpx;
  color: #1A1A1A;
  font-weight: 500;
  margin-bottom: 20rpx;
}

.form-label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.form-label-extra {
  font-size: 24rpx;
  color: #999999;
}

/* 数量选择 */
.quantity-box {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: -48rpx;
}

.qty-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 12rpx;
  background: #F5F5F7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #333333;
}

.qty-btn.disabled {
  opacity: 0.3;
}

.qty-num {
  width: 80rpx;
  text-align: center;
  font-size: 32rpx;
  color: #1A1A1A;
  font-weight: 500;
}

/* 大区选择 */
.region-list {
  display: flex;
  gap: 16rpx;
}

.region-item {
  padding: 16rpx 40rpx;
  border-radius: 12rpx;
  background: #F5F5F7;
  font-size: 26rpx;
  color: #666666;
}

.region-item.active {
  background: #3B82F6;
  color: #FFFFFF;
}

/* 输入框 */
.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  background: #F5F5F7;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333333;
}

.input-placeholder {
  color: #BBBBBB;
}

/* 备注 */
.remark-row {
  margin-bottom: 24rpx;
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  background: #F5F5F7;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333333;
  line-height: 40rpx;
}

/* 底部支付栏 */
.pay-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1rpx solid #EEEEEE;
}

.pay-left {
  display: flex;
  align-items: baseline;
}

.pay-label {
  font-size: 26rpx;
  color: #666666;
  margin-right: 8rpx;
}

.pay-price {
  display: flex;
  align-items: baseline;
}

.pay-symbol {
  font-size: 28rpx;
  color: #FF3B30;
  font-weight: bold;
}

.pay-num {
  font-size: 44rpx;
  color: #FF3B30;
  font-weight: bold;
}

.pay-btn {
  padding: 24rpx 80rpx;
  background: linear-gradient(135deg, #FF3B30, #FF6B6B);
  border-radius: 44rpx;
  font-size: 30rpx;
  color: #FFFFFF;
  font-weight: bold;
  box-shadow: 0 4rpx 16rpx rgba(255, 59, 48, 0.3);
}

.pay-btn:active {
  transform: scale(0.95);
  opacity: 0.9;
}

/* ===== 支付方式选择弹窗 ===== */
.pay-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s;
}

.pay-mask.show {
  opacity: 1;
  visibility: visible;
}

.pay-popup {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  padding: 30rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform 0.3s;
}

.pay-mask.show .pay-popup {
  transform: translateY(0);
}

.pay-popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.pay-popup-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1A1A1A;
}

.pay-popup-close {
  font-size: 40rpx;
  color: #999999;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pay-popup-amount {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 10rpx;
  padding: 20rpx 0 30rpx;
}

.pay-popup-amount-label {
  font-size: 28rpx;
  color: #666666;
}

.pay-popup-amount-val {
  font-size: 48rpx;
  font-weight: bold;
  color: #FF4D4F;
}

.pay-method-list {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  background: #F5F5F7;
  border-radius: 16rpx;
  overflow: hidden;
}

.pay-method-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  padding: 28rpx 24rpx;
}

.pay-method-item:active {
  background: #F9F9FA;
}

.pay-method-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.pay-method-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.pay-method-icon.wallet {
  background: #FFF3E0;
}

.pay-method-icon.wechat {
  background: #E8F5E9;
}

.pay-method-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.pay-method-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #1A1A1A;
}

.pay-method-desc {
  font-size: 24rpx;
  color: #999999;
}

.pay-method-arrow {
  font-size: 36rpx;
  color: #CCCCCC;
}
