/* pages/mine/mine.wxss */
.page-container {
  min-height: 100vh;
  background: #FFFFFF;
  padding-bottom: env(safe-area-inset-bottom);
}

.status-bar {
  width: 100%;
}

/* ============================================ */
/* ==========     普通用户版样式     ========== */
/* ============================================ */

/* ====== 用户信息区 ====== */
.user-header {
  position: relative;
  padding: 20rpx 30rpx 40rpx;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: -60rpx;
  left: -30rpx;
  right: -30rpx;
  height: 320rpx;
  background: linear-gradient(135deg, rgba(123, 97, 255, 0.08) 0%, rgba(167, 139, 250, 0.04) 50%, transparent 100%);
  border-radius: 0 0 40rpx 40rpx;
  z-index: 0;
}

.user-info {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

.avatar-box {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 3rpx solid rgba(123, 97, 255, 0.2);
  box-shadow: 0 4rpx 20rpx rgba(123, 97, 255, 0.1);
  flex-shrink: 0;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-default {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  background: rgba(123, 97, 255, 0.08);
}

.user-detail {
  flex: 1;
  margin-left: 24rpx;
}

.user-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #1A1A1A;
  margin-bottom: 8rpx;
}

.user-uid {
  font-size: 22rpx;
  color: #999999;
}

.user-tip {
  font-size: 24rpx;
  color: #AAAAAA;
}

.user-arrow {
  font-size: 40rpx;
  color: #CCCCCC;
}

.logout-btn {
  position: relative;
  z-index: 1;
  display: inline-block;
  margin-top: 12rpx;
  padding: 8rpx 28rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 107, 107, 0.3);
  font-size: 22rpx;
  color: #FF6B6B;
}

.logout-btn:active {
  background: rgba(255, 107, 107, 0.05);
}

/* ====== 数据统计卡片 ====== */
.stats-card {
  display: flex;
  align-items: center;
  margin: 0 30rpx;
  padding: 36rpx 20rpx;
  background: #F5F5F7;
  border: 1rpx solid #EEEEEE;
  border-radius: 24rpx;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 36rpx;
  font-weight: bold;
  color: #1A1A1A;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #999999;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: #EEEEEE;
}

/* ====== 通用 Section 卡片 ====== */
.section-card {
  margin: 24rpx 30rpx;
  padding: 28rpx 32rpx;
  background: #F5F5F7;
  border: 1rpx solid #EEEEEE;
  border-radius: 20rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1A1A1A;
}

.section-more {
  font-size: 24rpx;
  color: #999999;
}

.section-more:active {
  color: #7B61FF;
}

/* ====== 订单快捷入口 ====== */
.order-types {
  display: flex;
  justify-content: space-around;
}

.order-type-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.order-type-item:active {
  opacity: 0.6;
}

.order-type-icon {
  font-size: 52rpx;
  margin-bottom: 12rpx;
}

.order-type-text {
  font-size: 24rpx;
  color: #666666;
}

/* ====== 菜单列表 ====== */
.menu-list {
  display: flex;
  flex-direction: column;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #EEEEEE;
}

.menu-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.menu-item:first-child {
  padding-top: 0;
}

.menu-item:active {
  opacity: 0.6;
}

.menu-icon {
  font-size: 44rpx;
  width: 64rpx;
  text-align: center;
  flex-shrink: 0;
}

.menu-content {
  flex: 1;
  margin-left: 16rpx;
}

.menu-text {
  font-size: 28rpx;
  color: #1A1A1A;
  margin-bottom: 4rpx;
}

.menu-desc {
  font-size: 22rpx;
  color: #999999;
}

.menu-arrow {
  font-size: 36rpx;
  color: #CCCCCC;
}

/* ============================================ */
/* ==========     护航版样式     ========== */
/* ============================================ */

/* 顶部头部 */
.escort-header {
  position: relative;
  padding-bottom: 30rpx;
  overflow: hidden;
}

.escort-header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 420rpx;
  background: linear-gradient(180deg, #1A1A2E 0%, #16213E 60%, #0F3460 100%);
}

.escort-top {
  position: relative;
  z-index: 2;
  display: flex;
  justify-content: flex-end;
  padding: 20rpx 30rpx;
}

.escort-close {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.7);
}

.escort-user {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
}

.escort-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #7B61FF, #A78BFA);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  overflow: hidden;
  flex-shrink: 0;
  border: 3rpx solid rgba(255, 255, 255, 0.3);
}

.escort-avatar image {
  width: 100%;
  height: 100%;
}

.escort-info {
  flex: 1;
  margin-left: 20rpx;
}

.escort-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.escort-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #FFFFFF;
  margin-right: 12rpx;
}

.escort-badge {
  display: flex;
  align-items: center;
  padding: 4rpx 12rpx;
  background: linear-gradient(135deg, #667EEA, #764BA2);
  border-radius: 20rpx;
}

.badge-icon {
  font-size: 20rpx;
  margin-right: 4rpx;
}

.badge-text {
  font-size: 20rpx;
  color: #FFFFFF;
}

.escort-level-row {
  display: flex;
  align-items: center;
}

.level-badge {
  display: flex;
  align-items: center;
  padding: 6rpx 16rpx;
  background: linear-gradient(135deg, #C0C0C0, #E8E8E8);
  border-radius: 8rpx;
  margin-right: 16rpx;
}

.level-icon {
  font-size: 20rpx;
  margin-right: 4rpx;
}

.level-text {
  font-size: 20rpx;
  color: #666666;
  font-weight: 500;
}

.escort-region {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  padding: 4rpx 14rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 20rpx;
}

.escort-phone {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.phone-icon {
  font-size: 40rpx;
  margin-bottom: 6rpx;
}

.phone-status {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.phone-time {
  font-size: 22rpx;
  color: #34D399;
  font-weight: 500;
}

/* 收益卡片 */
.wallet-card {
  margin: -10rpx 24rpx 0;
  padding: 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.08);
  position: relative;
  z-index: 3;
}

.wallet-main {
  display: flex;
  align-items: center;
}

.wallet-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.wallet-num {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.wallet-num.negative {
  color: #FF6B6B;
}

.wallet-num.positive {
  color: #10B981;
}

.wallet-label {
  font-size: 24rpx;
  color: #999999;
}

.wallet-divider {
  width: 1rpx;
  height: 60rpx;
  background: #EEEEEE;
}

.withdraw-btn {
  margin-left: 20rpx;
  padding: 16rpx 36rpx;
  background: linear-gradient(135deg, #FF3B30, #FF6B6B);
  border-radius: 36rpx;
  font-size: 26rpx;
  color: #FFFFFF;
  font-weight: 500;
  box-shadow: 0 4rpx 16rpx rgba(255, 59, 48, 0.3);
}

.withdraw-btn:active {
  transform: scale(0.95);
  opacity: 0.9;
}

/* 功能入口 */
.func-entries {
  display: flex;
  gap: 20rpx;
  margin: 24rpx 24rpx;
}

.func-entry {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.func-entry:active {
  transform: scale(0.97);
  opacity: 0.8;
}

.func-left {
  display: flex;
  flex-direction: column;
}

.func-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #1A1A1A;
  margin-bottom: 6rpx;
}

.func-desc {
  font-size: 22rpx;
  color: #999999;
}

.func-icon-box {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.unread-badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: #EF4444;
  color: #FFFFFF;
  font-size: 20rpx;
  line-height: 32rpx;
  text-align: center;
  box-sizing: border-box;
}

.func-icon-box.green {
  background: linear-gradient(135deg, #D1FAE5, #A7F3D0);
}

.func-icon-box.orange {
  background: linear-gradient(135deg, #FED7AA, #FDBA74);
}

.func-icon {
  font-size: 40rpx;
}

/* 数据中心 */
.data-section {
  margin: 24rpx;
  padding: 28rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.data-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1A1A1A;
  margin-bottom: 24rpx;
}

.data-grid {
  display: flex;
}

.data-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.data-num {
  font-size: 40rpx;
  font-weight: bold;
  color: #1A1A1A;
  margin-bottom: 8rpx;
}

.data-label {
  font-size: 22rpx;
  color: #999999;
}

/* 我的工具 */
.tools-section {
  margin: 24rpx;
  padding: 28rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.tools-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1A1A1A;
  margin-bottom: 28rpx;
}

.tools-grid {
  display: flex;
  flex-wrap: wrap;
}

.tool-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  padding: 16rpx 0;
}

.tool-item:active {
  opacity: 0.6;
}

.tool-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.tool-text {
  font-size: 24rpx;
  color: #666666;
}

.tool-badge {
  position: absolute;
  top: 4rpx;
  right: 20rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  padding: 0 8rpx;
  background: #FF3B30;
  color: #FFFFFF;
  font-size: 20rpx;
  border-radius: 16rpx;
  box-sizing: border-box;
}

/* 退出登录 */
.escort-logout {
  margin: 40rpx 24rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #FFFFFF;
  border-radius: 44rpx;
  font-size: 28rpx;
  color: #FF6B6B;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.escort-logout:active {
  background: #FFF5F5;
}

/* ====== 底部信息 ====== */
.footer-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 20rpx;
}

.footer-text {
  font-size: 22rpx;
  color: #CCCCCC;
  margin-bottom: 8rpx;
}

.footer-version {
  font-size: 20rpx;
  color: #DDDDDD;
}

/* ============================================ */
/* ==========     收益详情视图样式     ========== */
/* ============================================ */

.earnings-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: #FFFFFF;
}

.earnings-nav .nav-close {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #333333;
}

.earnings-nav .nav-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #1A1A1A;
}

.earnings-nav .nav-kefu {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

/* 顶部钱包卡片 */
.earnings-wallet-card {
  margin: 0 24rpx 20rpx;
  padding: 30rpx 24rpx;
  background: linear-gradient(135deg, #FEE2E2, #FECACA);
  border-radius: 20rpx;
}

.earnings-wallet-card .wallet-row {
  display: flex;
  margin-bottom: 24rpx;
}

.earnings-wallet-card .wallet-row:last-child {
  margin-bottom: 0;
}

.earnings-wallet-card .wallet-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.earnings-wallet-card .wallet-label {
  font-size: 24rpx;
  color: #991B1B;
  opacity: 0.8;
  margin-bottom: 8rpx;
}

.earnings-wallet-card .wallet-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.earnings-wallet-card .wallet-value.income {
  color: #10B981;
}

/* 统计卡片 */
.earnings-stats-card {
  margin: 0 24rpx 20rpx;
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.stats-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.title-bar {
  width: 6rpx;
  height: 28rpx;
  border-radius: 3rpx;
  margin-right: 12rpx;
}

.title-bar.red {
  background: linear-gradient(180deg, #F87171, #EF4444);
}

.title-bar.gold {
  background: linear-gradient(180deg, #FBBF24, #F59E0B);
}

.title-bar.blue {
  background: linear-gradient(180deg, #60A5FA, #3B82F6);
}

.stats-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #1A1A1A;
}

.stats-title.blue {
  color: #2563EB;
}

.stats-grid {
  display: flex;
}

.stats-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stats-col .stats-label {
  font-size: 22rpx;
  color: #999999;
  margin-bottom: 8rpx;
}

.stats-col .stats-value {
  font-size: 30rpx;
  font-weight: bold;
  color: #1A1A1A;
}

/* Tab切换 */
.earnings-tab-header {
  display: flex;
  background: #FFFFFF;
  margin: 0 24rpx;
  border-radius: 16rpx 16rpx 0 0;
  padding-top: 10rpx;
  box-sizing: border-box;
}

.earnings-tab-header .tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666666;
  position: relative;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.earnings-tab-header .tab-item.active {
  color: #EF4444;
  font-weight: bold;
}

.earnings-tab-header .tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: #EF4444;
  border-radius: 3rpx;
}

/* 搜索框 */
.earnings-search-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #FFFFFF;
  margin: 0 24rpx;
  gap: 16rpx;
  box-sizing: border-box;
}

.earnings-search-bar .search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  height: 64rpx;
  background: #F7F8FA;
  border-radius: 32rpx;
  padding: 0 24rpx;
  min-width: 0;
}

.earnings-search-bar .search-icon {
  font-size: 24rpx;
  margin-right: 12rpx;
  opacity: 0.6;
  flex-shrink: 0;
}

.earnings-search-bar .search-input {
  flex: 1;
  font-size: 26rpx;
  color: #333333;
  width: 100%;
  min-width: 0;
}

.earnings-search-bar .search-btn {
  padding: 12rpx 32rpx;
  background: linear-gradient(135deg, #EF4444, #DC2626);
  color: #FFFFFF;
  font-size: 26rpx;
  border-radius: 32rpx;
  flex-shrink: 0;
  white-space: nowrap;
}

/* 列表区域 */
.earnings-list {
  height: auto;
  min-height: 400rpx;
  background: #FFFFFF;
  margin: 0 24rpx;
  border-radius: 0 0 16rpx 16rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  padding-bottom: 40rpx;
}

.list-count {
  text-align: right;
  font-size: 22rpx;
  color: #999999;
  padding: 16rpx 0;
}

.empty-tip {
  padding: 80rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #999999;
}

/* 接单情况订单卡片 */
.earn-order-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #F0F0F0;
}

.order-top-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.order-no-wrap {
  display: flex;
  align-items: center;
}

.order-no {
  font-size: 26rpx;
  color: #333333;
  font-weight: 500;
}

.copy-icon {
  margin-left: 8rpx;
  font-size: 22rpx;
}

.copy-icon.small {
  font-size: 20rpx;
  margin-left: 6rpx;
}

.order-status-tag {
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  flex-shrink: 0;
}

.order-status-tag.status-0 { background: #FEF3C7; color: #D97706; }
.order-status-tag.status-1 { background: #DBEAFE; color: #2563EB; }
.order-status-tag.status-2 { background: #D1FAE5; color: #059669; }
.order-status-tag.status-5 { background: #FED7AA; color: #EA580C; }

.order-time-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F5F5F7;
}

.order-time {
  font-size: 22rpx;
  color: #999999;
}

.order-qty {
  font-size: 22rpx;
  color: #999999;
}

.service-row {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F5F5F7;
  margin-bottom: 16rpx;
}

.service-row .service-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #F5F5F7;
  flex-shrink: 0;
}

.service-row .service-info {
  flex: 1;
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}

.service-row .service-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1A1A1A;
  margin-bottom: 6rpx;
}

.service-row .service-desc {
  font-size: 22rpx;
  color: #999999;
  margin-bottom: 8rpx;
}

.service-row .service-price {
  font-size: 30rpx;
  font-weight: bold;
  color: #EF4444;
}

.game-info-box {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F5F5F7;
  margin-bottom: 16rpx;
}

.game-info-box .game-row {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}

.game-info-box .game-label {
  font-size: 26rpx;
  color: #999999;
  flex-shrink: 0;
  width: 160rpx;
}

.game-info-box .game-value {
  font-size: 26rpx;
  color: #1A1A1A;
  flex: 1;
  font-weight: 500;
}

.user-row-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}

.user-row-item .user-label {
  font-size: 26rpx;
  color: #FF7A45;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.user-row-item.leader .user-label {
  color: #EA580C;
}

.user-row-item .user-avatar-icon {
  font-size: 26rpx;
  margin-right: 8rpx;
}

.user-row-item .user-name-text {
  font-size: 26rpx;
  color: #333333;
  font-weight: 500;
}

.card-footer-btn {
  display: flex;
  justify-content: flex-end;
  margin-top: 12rpx;
}

.view-screenshot {
  padding: 10rpx 28rpx;
  background: linear-gradient(135deg, #818CF8, #6366F1);
  color: #FFFFFF;
  font-size: 24rpx;
  border-radius: 24rpx;
}

/* 结算记录卡片 */
.settlement-card {
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #F0F0F0;
}

.settlement-top {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.settlement-label {
  font-size: 26rpx;
  color: #666666;
}

.settlement-amount {
  font-size: 32rpx;
  font-weight: bold;
  color: #DC2626;
  flex: 1;
  margin-left: 8rpx;
}

.settlement-status {
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  background: #D1FAE5;
  color: #059669;
}

.settlement-row {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}

.settlement-value {
  font-size: 24rpx;
  color: #666666;
  flex: 1;
}

.view-receipt {
  font-size: 24rpx;
  color: #EA580C;
}

/* 余额流水卡片 */
.flow-card {
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid #F0F0F0;
}

.flow-row {
  display: flex;
  align-items: center;
  padding: 6rpx 0;
}

.flow-label {
  font-size: 24rpx;
  color: #999999;
  min-width: 140rpx;
}

.flow-value {
  font-size: 24rpx;
  color: #333333;
  flex: 1;
}

.flow-amount {
  font-size: 26rpx;
  font-weight: bold;
}

.flow-amount.income {
  color: #059669;
}

.flow-amount.expense {
  color: #DC2626;
}

/* ============================================ */
/* ==========     登录弹窗样式     ========== */
/* ============================================ */

.login-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.login-modal {
  width: 600rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 50rpx 40rpx 30rpx;
  box-sizing: border-box;
}

.login-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333333;
  text-align: center;
  margin-bottom: 40rpx;
}

.login-avatar-row {
  display: flex;
  justify-content: center;
  margin-bottom: 40rpx;
}

.avatar-btn {
  width: 160rpx;
  height: 160rpx;
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  line-height: normal;
}

.avatar-btn::after {
  border: none;
}

.avatar-preview {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  object-fit: cover;
}

.avatar-placeholder {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #F5F5F5;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #CCCCCC;
}

.avatar-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.avatar-text {
  font-size: 22rpx;
  color: #999999;
}

.login-nickname-row {
  margin-bottom: 40rpx;
}

.nickname-input {
  width: 100%;
  height: 80rpx;
  background: #F7F7F7;
  border-radius: 12rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #333333;
}

.login-btn-row {
  display: flex;
  gap: 20rpx;
}

.login-cancel-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: #F5F5F5;
  color: #666666;
  font-size: 28rpx;
  border-radius: 12rpx;
}

.login-confirm-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: linear-gradient(135deg, #FF6B35 0%, #FF4D4F 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 12rpx;
}
