/* pages/order/order.wxss */
.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #F8F6FF 0%, #FFFFFF 30%);
  padding-bottom: env(safe-area-inset-bottom);
}

.status-bar {
  width: 100%;
  background: transparent;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  position: relative;
}

.nav-back {
  font-size: 48rpx;
  color: #333333;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back:active {
  opacity: 0.6;
}

.nav-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: 34rpx;
  font-weight: bold;
  color: #333333;
}

/* ====== 服务选择列表（未选服务时显示） ====== */
.select-header {
  padding: 30rpx 30rpx 10rpx;
}

.select-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1A1A1A;
  display: block;
  margin-bottom: 8rpx;
}

.select-subtitle {
  font-size: 24rpx;
  color: #999999;
  display: block;
}

.service-select-list {
  padding: 20rpx 30rpx;
}

.service-select-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  background: #FFFFFF;
  border: 1rpx solid #F0EDFF;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(123, 97, 255, 0.06);
  transition: all 0.2s;
}

.service-select-card:active {
  transform: scale(0.98);
  background: #FAF8FF;
  border-color: rgba(123, 97, 255, 0.3);
  box-shadow: 0 6rpx 24rpx rgba(123, 97, 255, 0.12);
}

.ssc-left {
  flex: 1;
}

.ssc-tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  color: #FFFFFF;
  margin-bottom: 10rpx;
}

.ssc-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #1A1A1A;
  margin-bottom: 6rpx;
}

.ssc-desc {
  font-size: 22rpx;
  color: #999999;
}

.ssc-right {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-left: 20rpx;
}

.ssc-icon {
  font-size: 56rpx;
  margin-bottom: 10rpx;
}

.ssc-price {
  display: flex;
  align-items: baseline;
}

.ssc-price-symbol {
  font-size: 22rpx;
  color: #FF6B6B;
  font-weight: bold;
}

.ssc-price-num {
  font-size: 34rpx;
  color: #FF6B6B;
  font-weight: bold;
  margin: 0 2rpx;
}

/* ====== 顶部大图横幅 ====== */
.hero-banner {
  position: relative;
  width: 100%;
  height: 420rpx;
  overflow: hidden;
  border-bottom-left-radius: 32rpx;
  border-bottom-right-radius: 32rpx;
}

.hero-image {
  width: 100%;
  height: 100%;
}

.hero-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 50%;
  background: linear-gradient(180deg, transparent 0%, rgba(123, 97, 255, 0.3) 100%);
}

.hero-nav {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  z-index: 2;
}

.hero-back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: #333333;
  backdrop-filter: blur(10px);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.hero-back:active {
  background: rgba(255, 255, 255, 1);
}

/* ====== 价格栏（标签 + 名称 + 描述 + 价格） ====== */
.price-bar {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin: -30rpx 30rpx 0;
  padding: 28rpx 32rpx;
  background: #FFFFFF;
  border: 1rpx solid #F0EDFF;
  border-radius: 24rpx;
  position: relative;
  box-shadow: 0 8rpx 30rpx rgba(123, 97, 255, 0.08);
  z-index: 10;
}

.price-bar::before {
  content: '';
  position: absolute;
  top: 0;
  left: 32rpx;
  right: 32rpx;
  height: 6rpx;
  background: linear-gradient(90deg, #7B61FF, #A78BFA, #C4B5FD);
  border-radius: 0 0 6rpx 6rpx;
  opacity: 0.6;
}

.price-bar-left {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-top: 10rpx;
}

.bar-tag {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  color: #FFFFFF;
  margin-bottom: 12rpx;
  align-self: flex-start;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.bar-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #1A1A1A;
  margin-bottom: 8rpx;
}

.bar-desc {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 14rpx;
}

.bar-price {
  display: flex;
  align-items: baseline;
}

.bar-symbol {
  font-size: 28rpx;
  color: #FF6B6B;
  font-weight: bold;
}

.bar-num {
  font-size: 48rpx;
  color: #FF6B6B;
  font-weight: bold;
  margin: 0 4rpx;
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.change-service-btn {
  padding: 12rpx 28rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, rgba(123, 97, 255, 0.1), rgba(167, 139, 250, 0.1));
  border: 1rpx solid rgba(123, 97, 255, 0.2);
  color: #7B61FF;
  font-size: 22rpx;
  font-weight: 500;
}

.change-service-btn:active {
  background: rgba(123, 97, 255, 0.15);
}

/* 介绍 */
.intro-section {
  margin: 24rpx 30rpx;
  padding: 28rpx 32rpx;
  background: #FFFFFF;
  border: 1rpx solid #F0EDFF;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(123, 97, 255, 0.04);
}

.intro-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1A1A1A;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}

.intro-title::before {
  content: '';
  display: inline-block;
  width: 8rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #7B61FF, #A78BFA);
  border-radius: 4rpx;
  margin-right: 12rpx;
}

.intro-content {
  font-size: 26rpx;
  color: #666666;
  line-height: 44rpx;
  padding-left: 20rpx;
  border-left: 2rpx solid #F0EDFF;
  margin-left: 4rpx;
}

/* 底部提交栏 */
.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(20px);
  border-top: 1rpx solid #F0EDFF;
  box-shadow: 0 -4rpx 20rpx rgba(123, 97, 255, 0.06);
}

.submit-actions-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-right: 16rpx;
}

.submit-action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 4rpx 16rpx;
}

.submit-action-icon {
  font-size: 32rpx;
  margin-bottom: 2rpx;
}

.submit-action-text {
  font-size: 18rpx;
  color: #999999;
}

.submit-left {
  display: flex;
  align-items: baseline;
  flex: 1;
}

.submit-total-label {
  font-size: 26rpx;
  color: #999999;
}

.submit-total-price {
  display: flex;
  align-items: baseline;
}

.submit-symbol {
  font-size: 28rpx;
  color: #FF6B6B;
  font-weight: bold;
}

.submit-num {
  font-size: 44rpx;
  color: #FF6B6B;
  font-weight: bold;
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.submit-btn {
  padding: 24rpx 64rpx;
  background: linear-gradient(135deg, #7B61FF, #A78BFA);
  border-radius: 44rpx;
  font-size: 30rpx;
  color: #FFFFFF;
  font-weight: bold;
  box-shadow: 0 6rpx 24rpx rgba(123, 97, 255, 0.35);
}

.submit-btn:active {
  transform: scale(0.95);
  opacity: 0.9;
}
