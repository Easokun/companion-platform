# ===========================================
#        后端配置模板 —— 复制为 .env 使用
# ===========================================

# ---------- 数据库 ----------
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=order_db
DB_POOL_SIZE=10

# ---------- 管理员 ----------
ADMIN_USER=admin
ADMIN_PASS=your_secure_password

# ---------- 存储模式 ----------
# memory = 内存存储（开发/单实例用）
# redis  = Redis 存储（生产/多实例用）
STORAGE_MODE=memory

# Redis 配置（STORAGE_MODE=redis 时生效）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- 微信登录 ----------
# mock   = 模拟登录（开发用）
# wechat = 真实微信登录
LOGIN_MODE=mock
WX_APPID=your_appid
WX_APPSECRET=your_appsecret

# ---------- Token 有效期 ----------
USER_TOKEN_DAYS=30
ADMIN_TOKEN_DAYS=1

# ---------- 微信支付 ----------
# mock   = 测试模式（直接标记已支付，不调微信支付）
# wechat = 真实微信支付（需要商户号、API密钥、证书）
PAY_MODE=mock
WX_MCH_ID=
WX_API_KEY=
WX_CERT_PATH=
WX_NOTIFY_URL=

# ---------- 图片存储 ----------
# local = 本地存储（开发用）
# oss   = 阿里云 OSS
# cos   = 腾讯云 COS
STORAGE_TYPE=local
UPLOAD_DIR=uploads
